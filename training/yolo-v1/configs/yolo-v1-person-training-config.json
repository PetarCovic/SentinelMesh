  "valImagesDir": "datasets/person-detection/coco2017/converted/val/images",
  "valLabelsDir": "datasets/person-detection/coco2017/converted/val/labels",

  "checkpointDir": "training/yolo-v1/checkpoints",
  "exportPath": "training/yolo-v1/exports/yolo-v1-person.weights"
}